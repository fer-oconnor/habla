# ----------------------------------------------------------------------------
# Habla - ejemplo de configuracion
# Copia este archivo como ".env" (npm run setup lo hace por ti si no existe).
# ----------------------------------------------------------------------------

# Puerto del servidor (frontend + API comparten puerto y origen)
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Ruta del archivo SQLite (relativa a la raiz del proyecto)
DATABASE_FILE=data/habla.db

# Poner en "true" solo si sirves la app detras de HTTPS.
# Activa la marca Secure en las cookies de sesion.
COOKIE_SECURE=false

# Duracion de la sesion en dias
SESSION_DAYS=30

# Origenes extra permitidos para peticiones de modificacion (separados por comas).
# Vacio = solo el mismo origen. Ejemplo: http://127.0.0.1:3000,http://localhost:3000
TRUSTED_ORIGINS=
